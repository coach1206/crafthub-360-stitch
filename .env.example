# ─────────────────────────────────────────────────────────────────
# NOVEE OS Backend — Environment Variables
# Copy to .env and fill in real values. Never commit .env.
#
# Production Hardening Phase 1: in production (NODE_ENV=production),
# server/config/envValidator.js enforces that JWT_SECRET,
# FOUNDER_CHALLENGE_SECRET, and (if set) SESSION_SECRET/
# STRIPE_SECRET_KEY/STRIPE_WEBHOOK_SECRET are present, at least 32
# characters, and NOT a known-unsafe placeholder value (e.g.
# "changeme", "secret", "default", "test", "password", or the literal
# dev-mode default). The server refuses to start in production with
# any of these unmet — it never silently falls back to a dev default.
# Generate real secrets with: openssl rand -hex 32 (or longer).
# Rotate any secret that may have been exposed (logged, committed, or
# shared) before reusing it.
# ─────────────────────────────────────────────────────────────────

# Backend server port (must not conflict with Vite on 5000)
PORT=3001

# Environment
NODE_ENV=development

# PostgreSQL connection string (leave blank to use prototype/in-memory mode)
DATABASE_URL=

# Allowed frontend origin for CORS
CORS_ORIGIN=http://localhost:5000

# ── JWT Authentication ────────────────────────────────────────
# REQUIRED in production. Generate with: openssl rand -hex 64
JWT_SECRET=

# ── Auth session durations ────────────────────────────────────
STAFF_PIN_EXPIRES_IN=4h
ADMIN_SESSION_EXPIRES_IN=8h
FOUNDER_SESSION_EXPIRES_IN=2h

# ── Lockout policy ────────────────────────────────────────────
MAX_FAILED_ATTEMPTS=5
LOCKOUT_MINUTES=15

# ── Founder Level 0 challenge ─────────────────────────────────
# REQUIRED for founder login. Set any secret string.
# Example: openssl rand -hex 32
FOUNDER_CHALLENGE_SECRET=

# ── Auth cookie ───────────────────────────────────────────────
AUTH_COOKIE_NAME=novee_auth
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax

# ── Dev-only: allow founder_level_0 via dev headers ──────────
# NEVER set true in production.
ALLOW_DEV_FOUNDER=false

# ── Founder env override (client-side fallback login) ────────
# Used by src/config/founderOverride.js so founder_level_0 access still
# works on static-only deployments (e.g. a Vercel preview that ships only
# the Vite `dist/` build, with no server/ backend deployed alongside it).
# Set both in the hosting provider's dashboard, never commit real values.
# WARNING: VITE_-prefixed vars are bundled into the client-side JS at
# build time — anyone with the built bundle can recover this PIN. This is
# a documented, intentional tradeoff for static-preview convenience, not
# a production-grade secret. The real founder login (email + PIN +
# FOUNDER_CHALLENGE_SECRET challenge, bcrypt-verified server-side) remains
# the secure path once the backend is deployed.
VITE_FOUNDER_ADMIN_EMAIL=
VITE_FOUNDER_ADMIN_PIN=

# ── Staff Handoff Demo Mode ───────────────────────────────────
# Set VITE_STAFF_DEMO_MODE=true to allow Staff Handoff to open
# POS3 and E.A.T. without real credentials (for live demos only).
# Always shows a clear "Demo Mode" label — never claims real auth.
VITE_STAFF_DEMO_MODE=false

# ── Venue identity ────────────────────────────────────────────
VENUE_ID=novee-grand-lounge
DEVICE_ID=kiosk-001

# ── Feature flags ─────────────────────────────────────────────
# Secret for signing session tokens (legacy / Phase 7)
SESSION_SECRET=

# ElevenLabs voice API key (Phase 9+). Required in production for
# SmokeCraft mentor voice previews (Holistic Fix 5B-2B-1) to return
# real synthesized audio — without it, every preview honestly reports
# status "unavailable" (reason "provider_not_configured") rather than
# fabricating a successful response. See
# docs/smokecraft/SMOKECRAFT_MENTOR_VOICE_MAP.md. Never expose this
# key to client code — it is read only by
# server/services/smokecraft/mentorVoiceService.js.
ELEVENLABS_API_KEY=

# POS 3 provider mode: prototype | clover | toast | square
POS3_PROVIDER_MODE=prototype

# E.A.T. Command provider mode: prototype | custom
EAT_PROVIDER_MODE=prototype

# ── Stripe Payment Keys ───────────────────────────────────────
# NOVEE OS platform payment layer — not a website payment form.
# Set these in your deployment provider (Railway, Render, etc.) — never commit real values.
#
# Backend secret key (NEVER expose to frontend, NEVER commit):
STRIPE_SECRET_KEY=
#
# Frontend publishable key (safe to expose — used by VITE at build time):
VITE_STRIPE_PUBLISHABLE_KEY=
#
# Webhook signing secret (for validating Stripe webhook events):
STRIPE_WEBHOOK_SECRET=

# ── Production Package 4 — deployment / infra ────────────────
# Public URL this deployment is reachable at. REQUIRED in production
# (must be https://).
APP_PUBLIC_URL=

# Set to true only if intentionally running production against a Stripe
# test-mode key (e.g. pre-launch soft-open). Otherwise leave unset.
ALLOW_STRIPE_TEST_IN_PRODUCTION=false

# ── Object storage (Production Package 4) ─────────────────────
# provider: local (dev only, REJECTED in production) | r2 | s3
STORAGE_PROVIDER=local
STORAGE_BUCKET=
STORAGE_REGION=auto
# R2 endpoint, e.g. https://<accountid>.r2.cloudflarestorage.com (S3 leave blank)
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
# Public CDN domain in front of the bucket (Cloudflare/CloudFront). Falls
# back to a controlled app-proxied URL if unset.
STORAGE_CDN_URL=
# staging vs production key namespace prefix — set explicitly per
# environment so a staging upload can never collide with production media.
STORAGE_KEY_PREFIX=

# ─────────────────────────────────────────────────────────────────
# Production startup checklist (also see
# public/proof/smokecraft-production-hardening-phase-1/ for full proof)
#
# [ ] NODE_ENV=production
# [ ] DATABASE_URL set to the real production Postgres connection string
# [ ] JWT_SECRET set — 32+ random characters, not a placeholder
#     (generate with: openssl rand -hex 32)
# [ ] FOUNDER_CHALLENGE_SECRET set — same requirement as JWT_SECRET
# [ ] CORS_ORIGIN set to the real production frontend origin
#     (a full https:// URL — never "*" or "true")
# [ ] AUTH_COOKIE_SECURE=true
# [ ] ALLOW_DEV_FOUNDER unset or false (hard-blocked in production
#     regardless of this value, but keep it unset for clarity)
# [ ] Only set STRIPE_SECRET_KEY / STRIPE_WEBHOOK_SECRET if the Stripe
#     integration is actually being enabled for this deployment — an
#     unset value keeps the payment boundary honestly "unavailable"
#     rather than failing startup
# [ ] Only set ELEVENLABS_API_KEY if real mentor-voice synthesis is
#     desired — unset falls back honestly to Web Speech API
# [ ] Confirm the server logs "[EnvValidator] ✓ Environment
#     configuration OK" (or only pre-approved warnings) on startup
# ─────────────────────────────────────────────────────────────────
